		TextTransparency = 0.5,
		AutoButtonColor = false,
		Size = UFO(28, 28),
		BorderSizePixel = 0,
	})
	GlassCorner(closeBtn, 14)
	Bind(closeBtn, { BackgroundColor3 = "Glass" })
	
	Connect(closeBtn.MouseButton1Click, function()
		self:Toggle(false)
	end)
	
	Hover(closeBtn, function(hovering)
		Tween(closeBtn, Anim.Fast, { 
			BackgroundColor3 = hovering and Callisto.Theme.Accent or Callisto.Theme.Glass,
			TextTransparency = hovering and 0 or 0.5,
			TextColor3 = hovering and RGB(255,255,255) or Callisto.Theme.Text,
		})
	end)

	--==== Tab Bar (top) ====
	local tabBar = Add("ScrollingFrame", {
		Parent = canvas,
		Name = "TabBar",
		BackgroundTransparency = 1,
		Position = UFO(14, 40),
		Size = UD2(1, -28, 0, 36),
		BorderSizePixel = 0,
		ScrollBarThickness = 0,
		CanvasSize = UFS(0, 0),
		AutomaticCanvasSize = AT.X,
		ClipsDescendants = false,
	})
	List(tabBar, { 
		FillDirection = FD.Horizontal, 
		Padding = UD(0, 6),
		VerticalAlignment = VFA.Center,
	})

	--==== Pages container (below tab bar) ====
	local pages = Add("Frame", {
		Parent = canvas,
		Name = "Pages",
		BackgroundTransparency = 1,
		Position = UFO(14, 80),
		Size = UD2(1, -28, 1, -96),
		ClipsDescendants = true,
		BorderSizePixel = 0,
	})
	Padding(pages, 2, 2)

	--==== Footer ====
	local footer = Add("Frame", {
		Parent = canvas,
		AnchorPoint = V2(0, 1),
		Name = "Footer",
		Position = UFS(0, 1),
		Size = UD2(1, 0, 0, 30),
		BorderSizePixel = 0,
	})
	GlassCorner(footer, 16)
	GlassStroke(footer, "Border", true)
	Bind(footer, { BackgroundColor3 = "Glass" })

	local footerLabel = Text(footer, {
		Text = opts.Footer or "https://discord.gg/robloxuis",
		TextTransparency = 0.4,
		Name = "Label",
		Size = UFS(0, 1),
		RichText = true,
		AutomaticSize = AT.X,
		TextSize = 12,
	})
	Padding(footerLabel, 0, 1, 14, 14)

	local resize = Add("ImageButton", {
		Parent = footer,
		ScaleType = SCL.Fit,
		ImageTransparency = 0.5,
		Name = "Resize",
		AnchorPoint = V2(1, 0),
		Image = "rbxassetid://89501307163630",
		BackgroundTransparency = 1,
		Position = UD2(1, -12, 0, 14),
		Size = UFO(12, 12),
		ResampleMode = RSM.Pixelated,
		BorderSizePixel = 0,
	})
	Hover(resize, function(hovering)
		Tween(resize, Anim.Fast, { ImageTransparency = hovering and 0 or 0.5 })
	end)

	--==== Externals ====
	local externals = Add("Frame", {
		Parent = screenGui,
		Name = "Externals",
		BackgroundTransparency = 1,
		Size = UFS(1, 1),
		ZIndex = 100,
		BorderSizePixel = 0,
	})

	local window: any = setmetatable({
		Root = root,
		ScreenGui = screenGui,
		Canvas = canvas,
		Header = header,
		Title = title,
		TabBar = tabBar,
		Pages = pages,
		Footer = footer,
		Externals = externals,
		PageList = {},
		CurrentPage = nil,
		Visible = true,
		HomePosition = nil,
	}, Window)

	MakeDraggable(header, canvas)
	MakeResizable(resize, canvas, opts.MinSize or V2(480, 340))

	local toggleKey = opts.Keybind or EKC.RightShift
	Connect(UserInputService.InputBegan, function(input, processed)
		if processed then
			return
		end
		if input.UserInputType == UIT.Keyboard and input.KeyCode == toggleKey then
			window:Toggle()
		end
	end)

	local home = canvas.Position
	Fader.Out(canvas, TI(0))
	canvas.Position = home + UD2(0, 0, 0, 15)
	Tween(canvas, Anim.Spring, { Position = home })
	Fader.In(canvas, Anim.Slow)

	TIS(Callisto.Windows, window)
	return window
end

function Callisto:Unload()
	if ThemeTransition then
		ThemeTransition:Disconnect()
		ThemeTransition = nil
	end

	for _, connection in next, self.Connections do
		pcall(function()
			connection:Disconnect()
		end)
	end
	table.clear(self.Connections)

	for index = #self.Windows, 1, -1 do
		self.Windows[index].Root:Destroy()
		self.Windows[index] = nil
	end

	table.clear(ColorRegistry)
	table.clear(GradientRegistry)
	table.clear(self.Flags)
	Fader.Clear()
end

return Callisto
