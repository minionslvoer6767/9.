	}, Page)

	local function setActive(active: boolean, animate: boolean?)
		local info = animate == false and TI(0) or Anim.Base
		Tween(button, info, { 
			BackgroundTransparency = active and 0 or 1,
			BackgroundColor3 = active and Callisto.Theme.Glass or Callisto.Theme.Glass,
		})
		Tween(glowGrad, info, { Transparency = active and 0.2 or 1 })
