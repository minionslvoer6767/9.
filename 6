-- Toggle: pill-shaped with glow (completely different)
function SubElement.Toggle(parent: Instance, default: boolean, callback: (boolean) -> ())
	local state = default and true or false

	local button = Add("TextButton", {
		Parent = parent,
		Text = "",
		AutoButtonColor = false,
		Name = "Toggle",
		Size = UFO(44, 24),
		BorderSizePixel = 0,
	})
	GlassCorner(button, 12)
	Bind(button, { BackgroundColor3 = "Foreground" })
	GlassStroke(button, "Border", true)
	GlowShadow(button)
	
	local glow = Add("Frame", {
		Parent = button,
		Name = "Glow",
		BackgroundTransparency = 1,
		Size = UFS(1, 1),
		BorderSizePixel = 0,
		ZIndex = 1,
	})
	GlassCorner(glow, 12)
	local glowGrad = GlowGradient(glow)
	glowGrad.Transparency = 1

	local knob = Add("Frame", {
		Parent = button,
		AnchorPoint = V2(0, 0.5),
		Name = "Knob",
		BackgroundTransparency = 0,
		Position = UD2(0, 2, 0.5, 0),
		Size = UFO(18, 18),
		ZIndex = 2,
		BorderSizePixel = 0,
	})
	GlassCorner(knob, 9)
	Bind(knob, { BackgroundColor3 = "Glass" })
	GlassStroke(knob, "Border", false)
	
	local knobGlow = Add("Frame", {
		Parent = knob,
		Name = "KnobGlow",
		BackgroundTransparency = 1,
		Size = UFS(1, 1),
		BorderSizePixel = 0,
		ZIndex = 3,
	})
	GlassCorner(knobGlow, 9)
	GlowGradient(knobGlow)

	local function render(animate: boolean?)
		local info = animate == false and TI(0) or (state and Anim.Spring or Anim.Base)
		Tween(button, info, { 
			BackgroundColor3 = state and Callisto.Theme.Accent or Callisto.Theme.Foreground 
		})
		Tween(glowGrad, info, { Transparency = state and 0.4 or 1 })
		Tween(knob, state and Anim.Spring or Anim.Base, {
			Position = state and UD2(1, -22, 0.5, 0) or UD2(0, 2, 0.5, 0),
			BackgroundColor3 = state and RGB(255,255,255) or Callisto.Theme.Glass,
		})
		Tween(knobGlow, info, { BackgroundTransparency = state and 0.4 or 1 })
	end

	render(false)

	Connect(button.MouseButton1Click, function()
		state = not state
		render()
		task.spawn(callback, state)
	end)

	Hover(button, function(hovering)
		Tween(button, Anim.Fast, { Size = hovering and UFO(48, 26) or UFO(44, 24) })
	end)

	return {
		Instance = button,
		Get = function()
			return state
		end,
		Set = function(_, value: boolean)
			state = value and true or false
			render()
			task.spawn(callback, state)
		end,
	}
end

