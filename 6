			BorderSizePixel = 0,
		})
		GlassCorner(button, 8)
		GlassShadow(button, 0.3)
		GlassStroke(button, "Border", true)
		Bind(button, { BackgroundColor3 = "Foreground" })
		
		local glow = Add("Frame", {
			Parent = button,
			Name = "Glow",
			BackgroundTransparency = 1,
			Size = UFS(1, 1),
			ZIndex = 2,
			BorderSizePixel = 0,
		})
		GlassCorner(glow, 8)
